# MedScan Environment Configuration
# GEMINI_API_KEY: Required for Gemini AI API calls. AI Studio automatically injects this at runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV="development"

# PostgreSQL Connection String (Optional in dev; fallback to in-process Postgres if omitted)
# Example: postgresql://username:password@localhost:5432/medscan
DATABASE_URL=""

# Secret key for signing session cookies
SESSION_SECRET="medscan-super-secure-session-secret-key-32chars"

# Gemini Model alias
GEMINI_MODEL="gemini-3.8-flash"
